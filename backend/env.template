# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
MODEL=claude-opus-4-6

# ── OpenROAD Flow Scripts ─────────────────────────────────────────────────────
# Path to the root of your OpenROAD-flow-scripts clone
ORFS_DIR=/path/to/OpenROAD-flow-scripts

# ── Docker (set to 0 to run ORFS locally instead) ────────────────────────────
USE_DOCKER=1
ORFS_DOCKER_IMAGE=openroad/orfs:latest

# ── ORFS Flow Settings ────────────────────────────────────────────────────────
PLATFORM=sky130hd
MAKE_TARGET=final
MAKE_JOBS=4

# ── Pipeline I/O ──────────────────────────────────────────────────────────────
OUT_ROOT=./pipeline_out

# Team checkout, used to stamp findings with the git head they were observed at.
# Only needed when the backend sits beside the repo rather than inside it. Without
# it findings still emit, but cannot be tied to a code state.
BACKEND_GIT_REPO=
# Spec revision recorded on each finding. Must match what Validation uses.
SPEC_REVISION=golden_ddr3_1600k_x8_2lane_1rank
