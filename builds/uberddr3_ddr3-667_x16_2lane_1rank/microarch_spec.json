    "mode": "abstract",
    "dq_width_bits": 32,
    "dqs_count": 2,
    "dm_enabled": true,
    "ck_pair_present": true,
    "notes": "Abstracted DRAM boundary. Command/data semantics only. UberDDR3: 4:1 controller; the controller hands the PHY four command slots per controller cycle and the PHY serialises them onto the pins at the DDR clock. Validation observes the DRAM pins at the DDR clock, one command per tCK.",
    "commands_per_controller_cycle": 4
  },
