            "bits": "7",
            "access": "WO",
            "reset_value": 0,
            "description": "Write 1 to enter self-refresh"
          },
          {
            "name": "reserved",
            "bits": "31:8",
            "access": "RO",
            "reset_value": 0,
            "description": "Reserved"
          }
        ]
      },
      {
        "name": "TIMING_0",
        "offset": "0x08",
        "access": "RW",
        "reset_value": "0x150F0606",
        "fields": [
          {
            "name": "tRCD_nCK",
            "bits": "7:0",
