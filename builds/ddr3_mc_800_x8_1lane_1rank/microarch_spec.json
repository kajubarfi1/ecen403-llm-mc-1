          {
            "name": "reserved",
            "bits": "31:9",
            "access": "RO",
            "reset_value": 0,
            "description": "Reserved"
          }
        ]
      },
      {
        "name": "CTRL_CONFIG",
        "offset": "0x04",
        "access": "RW",
        "reset_value": "0x0000000A",
        "fields": [
          {
            "name": "sched_policy",
