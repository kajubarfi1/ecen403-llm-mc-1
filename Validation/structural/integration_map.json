  "glue": [
    {
      "from": "scheduler.cmd_bank",
      "to": [
        "bank_tracker.cmd_pre_bank",
        "bank_tracker.cmd_rd_bank",
        "bank_tracker.cmd_wr_bank"
      ],
      "delay_cycles": 1,
      "why": "cmd_gen's feedback interface carries a bank number only for ACTIVATE (fb_act_bank); its PRE/RD/WR pulses are bankless, yet bank_tracker needs cmd_pre_bank/cmd_rd_bank/cmd_wr_bank to track per-bank state. The harness registers the scheduler's cmd_bank one cycle so it aligns with the REGISTERED fb pulses. This is testbench glue standing in for a missing design signal \u2014 see the filed finding; the Frontend should add fb_pre_bank/fb_rd_bank/fb_wr_bank."
    },
    {
      "from": "scheduler.cmd_aux",
      "to": [
        "data_path.cmd_aux"
      ],
      "delay_cycles": 1,
      "why": "cmd_gen's feedback carries no aux tag, but data_path needs the issued command's aux to tag read responses (rd_rsp_aux). Registered one cycle to align with the registered fb_rd_valid/fb_wr_valid pulses. Same missing-feedback-signal gap as the bank workaround \u2014 covered by the filed fb-bank finding; the design wants fb_aux."
    }
  ],
  "ties": {
    "refresh_ctrl.init_done": "1'b1",
    "$why_init_done": "FALLBACK when init_fsm is not instantiated (command-path harnesses): refresh_ctrl waits for init_done before counting tREFI, and a tied-low init_done would silently disable every refresh. When init_fsm IS instantiated, the real init_fsm.init_done connection takes precedence.",
    "init_fsm.enable": "1'b1",
    "$why_enable": "init_fsm starts as soon as reset releases; the harness has no power-management layer to gate it."
  },
  "requires": {
    "$comment": "Support-block closure: instantiating a block pulls these in, because tied-zero substitutes for them are behaviourally wrong (a zeroed bank_act_allowed blocks every ACTIVATE; zeroed cfg timings erase every constraint).",
    "scheduler": [
      "cmd_queue",
      "bank_tracker",
      "refresh_ctrl"
    ],
    "bank_tracker": [
      "config_regs",
      "cmd_gen"
    ],
    "refresh_ctrl": [
      "config_regs"
    ],
    "cmd_gen": [
      "scheduler"
    ],
    "cmd_queue": [
      "addr_decoder",
      "scheduler"
    ],
    "addr_decoder": [
      "wb_port"
    ],
    "wb_port": [
      "data_path"
    ],
    "data_path": [
      "cmd_gen",
      "config_regs"
    ],
    "calibration": [
      "init_fsm"
    ]
  },
  "expr_glue": [
    {
      "to": "data_path.wr_data_valid",
      "expr": "wb_port.req_valid && wb_port.req_we && cmd_queue.enq_ready",
      "why": "data_path buffers a write word when wb_port's write request is ACCEPTED (valid && we && ready). No single design port carries that event; it is the same accept condition cmd_queue enqueues on."
    },
    {
      "to": "calibration.zqcs_ack",
      "expr": "calibration.zqcs_req",
      "why": "Nothing in the drop consumes zqcs_req: no scheduler or cmd_gen port accepts a ZQCS request, so periodic ZQ calibration can never be granted by the design itself \u2014 an integration gap (finding filed). The harness acks immediately so the calibration FSM does not wedge; the cal_zqcs monitor still observes every request."
    }
  ],
  "stubs": [
    {
      "module": "dram_stub",
      "instance": "u_dram",
      "source": "Validation/structural/dram_stub.sv",
      "when_block": "data_path",
      "$why": "Something must sit on the far side of the DDR pins or every read returns the tied-off bus. A behavioral DRAM: ACT opens rows, WR stores the burst word, RD replies after CL. Testbench component \u2014 nothing judges the design against it.",
      "inputs": {
        "clk": "@clk",
        "rst_n": "@rst_n",
        "ddr_cmd": "cmd_gen.ddr_cmd",
        "ddr_addr": "cmd_gen.ddr_addr",
        "ddr_bank": "cmd_gen.ddr_bank",
        "ddr_dq_o": "data_path.ddr_dq_o",
        "ddr_dq_oe": "data_path.ddr_dq_oe",
        "cfg_CL_nCK": "config_regs.cfg_CL_nCK",
        "cfg_CWL_nCK": "config_regs.cfg_CWL_nCK"
      },
      "outputs": {
        "ddr_dq_i": "data_path.ddr_dq_i",
        "ddr_dqs_i": "data_path.ddr_dqs_i"
      }
    }
  ]
