  "ties": {
    "refresh_ctrl.init_done": "1'b1",
    "$why_init_done": "FALLBACK when init_fsm is not instantiated (command-path harnesses): refresh_ctrl waits for init_done before counting tREFI, and a tied-low init_done would silently disable every refresh. When init_fsm IS instantiated, the real init_fsm.init_done connection takes precedence.",
    "init_fsm.enable": "1'b1",
    "$why_enable": "init_fsm starts as soon as reset releases; the harness has no power-management layer to gate it."
  },
  "standalone_ties": {
    "$comment": "Ties for the edges a `standalone` path cuts: a single block judged on its own streams, for a drop that does not yet contain its neighbours (phase-by-phase integration). Every cut edge MUST be listed with a why, or chain_harness_gen refuses the path -- the ordinary zero tie-off is not allowed to stand in for a missing block. A standalone path also runs on a complete drop, so its evidence is comparable across phases.",
    "wb_port.req_ready": {
      "value": "1'b1",
      "why": "cmd_queue absent: the environment accepts every request at once. The wb_port predictor judges the req stream (one request per host access, with its address/data/mask/we) and the Wishbone handshake; what the queue would do with it is Phase 3's question."
    },
    "wb_port.rsp_valid": {
      "value": "1'b0",
      "why": "data_path absent: no read data ever returns. Reads stay pending; the predictor's completes_on rule emits no wb_rsp for them and the standalone path drives writes only (path stimulus_kinds)."
    },
    "wb_port.rsp_rdata": {
      "value": "'0",
      "why": "unused while rsp_valid is tied low"
    },
    "wb_port.rsp_aux": {
      "value": "'0",
      "why": "unused while rsp_valid is tied low"
    },
    "config_regs.sts_init_done": {
      "value": "1'b0",
      "why": "init_fsm absent: CTRL_STATUS reports no boot progress. The register-walk path judges every register's RW/RO/W1C/reserved-bit semantics and the CTRL_STATUS read must show the tied value; the live status bits are judged by path_14/15/16 once their sources are in the drop."
    },
    "config_regs.sts_cal_done": {
      "value": "1'b0",
      "why": "calibration absent (see sts_init_done)"
    },
    "config_regs.sts_cal_fail": {
      "value": "1'b0",
      "why": "calibration absent (see sts_init_done)"
    },
    "config_regs.sts_ref_pending_cnt": {
      "value": "'0",
      "why": "refresh_ctrl absent (see sts_init_done)"
    },
    "config_regs.sts_ref_starve_event": {
      "value": "1'b0",
      "why": "refresh_ctrl absent (see sts_init_done)"
    },
    "config_regs.sts_init_fail_event": {
      "value": "1'b0",
      "why": "init_fsm absent (see sts_init_done)"
    }
  },
