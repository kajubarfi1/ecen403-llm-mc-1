    {
      "id": "path_04_scheduler_bank_loop",
      "name": "Scheduler → cmd_gen → Bank Tracker → Scheduler Feedback Loop",
      "category": "feedback_loop",
      "blocks": [
        "scheduler",
        "cmd_gen",
        "bank_tracker"
      ],
      "connections_used": [
        "conn_07",
        "conn_09",
        "conn_05"
      ],
      "rtl_files": [
        "scheduler.sv",
        "cmd_gen.sv",
        "bank_tracker.sv"
      ],
      "check_strategy": "invariant",
      "check_strategy_reason": "feedback loop: no entry/exit to predict across; check bank-state consistency and command legality",
      "stimulus_kinds": [
        "write"
      ]
    },
    {
      "id": "path_05_scheduler_refresh_loop",
      "name": "Scheduler ↔ Refresh Controller Feedback Loop",
      "category": "feedback_loop",
      "blocks": [
        "scheduler",
        "refresh_ctrl"
      ],
      "connections_used": [
        "conn_06",
        "conn_08"
      ],
      "rtl_files": [
        "scheduler.sv",
        "refresh_ctrl.sv"
      ],
      "check_strategy": "invariant",
      "check_strategy_reason": "feedback loop: refresh request/ack handshake, check liveness and tREFI bounds",
      "stimulus_kinds": [
        "write"
      ],
      "stimulus_generator": "refresh_stress",
      "settle_cycles": 6000,
      "stimulus_reason": "CSR programs a short tREFI and a small postpone budget, then sustained writes keep the scheduler busy so refresh is postponed to the urgent threshold — the REF_001 / TIMING_012 antecedents."
    },
    {
      "id": "path_06_scheduler_dequeue",
      "name": "Scheduler → Command Queue Dequeue",
      "category": "scheduling",
      "blocks": [
        "scheduler",
        "cmd_queue"
      ],
      "connections_used": [
        "conn_10"
      ],
      "rtl_files": [
        "scheduler.sv",
        "cmd_queue.sv"
      ],
      "check_strategy": "exact",
      "check_strategy_reason": "scheduler grant -> cmd_queue dequeue is a direct two-block handshake Judged as the cmd_queue+scheduler stage of path_01 (same hop, same checker); its report is derived from that run.",
      "stimulus_kinds": [
        "write"
      ],
      "judged_in": {
        "host": "path_01_write_cmd",
        "stage": "cmd_queue+scheduler"
      }
    },
    {
      "id": "path_07_backpressure",
      "name": "Command Queue → Wishbone Backpressure",
      "category": "flow_control",
      "blocks": [
        "wb_port",
        "addr_decoder",
        "cmd_queue",
        "scheduler"
      ],
      "connections_used": [
        "conn_12"
      ],
      "rtl_files": [
        "wb_port.sv",
        "addr_decoder.sv",
        "cmd_queue.sv",
        "scheduler.sv"
      ],
      "entry_boundary": {
        "type": "internal",
        "entity": "cmd_queue",
        "signals": [
          "enq_ready",
          "queue_count"
        ]
      },
      "exit_boundary": {
        "type": "external",
        "entity": "HOST",
        "signals": [
          "wb_stall_o"
        ]
      },
      "check_strategy": "composed",
      "check_strategy_reason": "Back-pressure only exists when the queue is full, so the path drives a burst of more than command_queue_depth writes with no idle cycles. wb_port is judged exactly (every accepted request must be forwarded once), and the cmd_queue+scheduler stage's conservation rules prove no accepted request is lost while the host is stalled. cg_cmd_queue.cp_backpressure_exercised proves the stall actually happened.",
      "stimulus_kinds": [
        "write"
      ],
      "stimulus_generator": "burst",
      "settle_cycles": 3000
    },
    {
      "id": "path_08_init_to_cal",
      "mode": "event",
      "name": "Init FSM → Calibration",
      "category": "init",
      "blocks": [
        "init_fsm",
        "calibration"
      ],
      "connections_used": [
        "conn_15"
      ],
      "rtl_files": [
        "init_fsm.sv",
        "calibration.sv"
      ],
      "check_strategy": "invariant",
      "check_strategy_reason": "autonomous: nothing is driven; the init FSM and calibration run from reset. Ordering (INIT_001, INIT_003, CAL_001, CAL_002) is judged by the path checker; inter-step timing (INIT_002) by init_fsm_sva.",
      "window_cycles": 180000
    },
