  "direct_connections": [
    {
      "id": "conn_01",
      "from": "wb_port",
      "to": "addr_decoder",
      "category": "request_path",
      "signals": [
        { "source_port": "req_addr", "sink_port": "req_addr", "width": 29 }
      ],
      "desc": "Wishbone port forwards host byte address to address decoder."
    },
    {
      "id": "conn_02",
      "from": "wb_port",
      "to": "cmd_queue",
      "category": "request_path",
      "signals": [
        { "source_port": "req_valid", "sink_port": "enq_valid", "width": 1 },
        { "source_port": "req_we",    "sink_port": "enq_we",    "width": 1 },
        { "source_port": "req_aux",   "sink_port": "enq_aux",   "width": 4 }
      ],
      "desc": "Wishbone port pushes request control into cmd_queue. Write data/mask handled separately via data_path."
    },
    {
      "id": "conn_03",
      "from": "addr_decoder",
      "to": "cmd_queue",
      "category": "request_path",
      "signals": [
        { "source_port": "dec_row",  "sink_port": "enq_row",  "width": 15 },
        { "source_port": "dec_col",  "sink_port": "enq_col",  "width": 10 },
        { "source_port": "dec_bank", "sink_port": "enq_bank", "width": 3 }
      ],
      "desc": "Decoded row/col/bank fields registered into cmd_queue entry."
    },
    {
      "id": "conn_04",
      "from": "cmd_queue",
      "to": "scheduler",
      "category": "scheduling",
      "signals": [
        { "source_port": "entry_valid", "sink_port": "q_valid", "width": 16 },
        { "source_port": "entry_row",   "sink_port": "q_row",  "width": "16x15" },
        { "source_port": "entry_col",   "sink_port": "q_col",  "width": "16x10" },
        { "source_port": "entry_bank",  "sink_port": "q_bank", "width": "16x3" },
        { "source_port": "entry_we",    "sink_port": "q_we",   "width": "16x1" },
        { "source_port": "entry_aux",   "sink_port": "q_aux",  "width": "16x4" }
      ],
      "desc": "Command queue exposes per-entry fields to scheduler."
    },
    {
      "id": "conn_05",
      "from": "bank_tracker",
      "to": "scheduler",
      "category": "scheduling",
      "signals": [
        { "source_port": "bank_is_active",   "sink_port": "bank_is_active",   "width": 8 },
        { "source_port": "bank_open_row",    "sink_port": "bank_open_row",    "width": "8x15" },
        { "source_port": "bank_act_allowed", "sink_port": "bank_act_allowed", "width": 8 },
        { "source_port": "bank_rd_allowed",  "sink_port": "bank_rd_allowed",  "width": 8 },
        { "source_port": "bank_wr_allowed",  "sink_port": "bank_wr_allowed",  "width": 8 },
        { "source_port": "bank_pre_allowed", "sink_port": "bank_pre_allowed", "width": 8 }
      ],
      "desc": "Bank tracker provides per-bank state and timing-clear flags to scheduler."
    },
    {
      "id": "conn_06",
      "from": "refresh_ctrl",
      "to": "scheduler",
      "category": "scheduling",
      "signals": [
        { "source_port": "ref_required", "sink_port": "ref_required", "width": 1 },
        { "source_port": "ref_urgent",   "sink_port": "ref_urgent",   "width": 1 }
      ],
      "desc": "Refresh controller signals pending/urgent refresh to scheduler."
    },
    {
      "id": "conn_07",
      "from": "scheduler",
      "to": "cmd_gen",
      "category": "scheduling",
      "signals": [
        { "source_port": "cmd_valid", "sink_port": "sched_valid", "width": 1 },
        { "source_port": "cmd_type",  "sink_port": "sched_type",  "width": 4 },
        { "source_port": "cmd_bank",  "sink_port": "sched_bank",  "width": 3 },
        { "source_port": "cmd_row",   "sink_port": "sched_row",   "width": 15 },
        { "source_port": "cmd_col",   "sink_port": "sched_col",   "width": 10 },
        { "source_port": "cmd_we",    "sink_port": "sched_we",    "width": 1 },
        { "source_port": "cmd_aux",   "sink_port": "sched_aux",   "width": 4 }
      ],
      "desc": "Scheduler issues selected command to cmd_gen for DDR3 encoding."
    },
    {
      "id": "conn_08",
      "from": "scheduler",
      "to": "refresh_ctrl",
      "category": "scheduling",
      "signals": [
        { "source_port": "ref_ack", "sink_port": "ref_ack", "width": 1 }
      ],
      "desc": "Scheduler acknowledges refresh command was issued."
    },
    {
      "id": "conn_09",
      "from": "cmd_gen",
      "to": "bank_tracker",
      "category": "feedback",
      "signals": [
        { "source_port": "fb_act_valid", "sink_port": "cmd_act_valid", "width": 1 },
        { "source_port": "fb_act_bank",  "sink_port": "cmd_act_bank",  "width": 3 },
        { "source_port": "fb_act_row",   "sink_port": "cmd_act_row",   "width": 15 },
        { "source_port": "fb_rd_valid",  "sink_port": "cmd_rd_valid",  "width": 1 },
        { "source_port": "fb_wr_valid",  "sink_port": "cmd_wr_valid",  "width": 1 },
        { "source_port": "fb_pre_valid", "sink_port": "cmd_pre_valid", "width": 1 },
        { "source_port": "fb_ref_valid", "sink_port": "cmd_ref_valid", "width": 1 }
      ],
      "desc": "cmd_gen feeds back per-command-type valids to bank_tracker."
    },
    {
      "id": "conn_10",
      "from": "scheduler",
      "to": "cmd_queue",
      "category": "scheduling",
      "signals": [
        { "source_port": "deq_grant", "sink_port": "deq_grant", "width": 1 },
        { "source_port": "deq_idx",   "sink_port": "deq_idx",   "width": 4 }
      ],
      "desc": "Scheduler grants dequeue of selected entry from cmd_queue."
    },
    {
      "id": "conn_11",
      "from": "data_path",
      "to": "wb_port",
      "category": "data_path",
      "$note": "data_path manifest missing — cannot verify",
      "signals": [
        { "source_port": "rsp_valid", "sink_port": "rsp_valid", "width": 1 },
        { "source_port": "rsp_rdata", "sink_port": "rsp_rdata", "width": 32 },
        { "source_port": "rsp_aux",   "sink_port": "rsp_aux",   "width": 4 }
      ],
      "desc": "Data path returns deserialized read data to Wishbone port."
    },
    {
      "id": "conn_12",
      "from": "cmd_queue",
      "to": "wb_port",
      "category": "backpressure",
      "signals": [
        { "source_port": "enq_ready", "sink_port": "req_ready", "width": 1 }
      ],
      "desc": "Command queue backpressure to Wishbone port when full."
    },
    {
      "id": "conn_13",
      "from": "config_regs",
      "to": "bank_tracker",
      "category": "config",
      "signals": [
        { "source_port": "cfg_tRCD_nCK", "sink_port": "cfg_tRCD_nCK", "width": 8 },
        { "source_port": "cfg_tRP_nCK",  "sink_port": "cfg_tRP_nCK",  "width": 8 },
        { "source_port": "cfg_tRAS_nCK", "sink_port": "cfg_tRAS_nCK", "width": 8 },
        { "source_port": "cfg_tRC_nCK",  "sink_port": "cfg_tRC_nCK",  "width": 8 },
        { "source_port": "cfg_tRRD_nCK", "sink_port": "cfg_tRRD_nCK", "width": 8 },
        { "source_port": "cfg_tFAW_nCK", "sink_port": "cfg_tFAW_nCK", "width": 8 },
        { "source_port": "cfg_tWTR_nCK", "sink_port": "cfg_tWTR_nCK", "width": 8 },
        { "source_port": "cfg_tWR_nCK",  "sink_port": "cfg_tWR_nCK",  "width": 8 },
        { "source_port": "cfg_tRTP_nCK", "sink_port": "cfg_tRTP_nCK", "width": 8 },
        { "source_port": "cfg_tCCD_nCK", "sink_port": "cfg_tCCD_nCK", "width": 8 },
        { "source_port": "cfg_tRFC_nCK", "sink_port": "cfg_tRFC_nCK", "width": 8 }
      ],
      "desc": "CSR timing registers to bank tracker (11 individual timing parameters)."
    },
    {
      "id": "conn_14",
      "from": "config_regs",
      "to": "refresh_ctrl",
      "category": "config",
      "signals": [
        { "source_port": "cfg_max_postpone",     "sink_port": "cfg_max_postpone",     "width": 4 },
        { "source_port": "cfg_urgent_threshold", "sink_port": "cfg_urgent_threshold",  "width": 4 },
        { "source_port": "cfg_force_refresh",    "sink_port": "cfg_force_refresh",     "width": 1 },
        { "source_port": "cfg_ref_priority",     "sink_port": "cfg_ref_priority",      "width": 1 },
        { "source_port": "cfg_tREFI_nCK",        "sink_port": "cfg_tREFI_nCK",        "width": 24 }
      ],
      "desc": "CSR refresh configuration to refresh controller."
    },
    {
      "id": "conn_15",
      "from": "init_fsm",
      "to": "calibration",
      "category": "init",
      "signals": [
        { "source_port": "init_done", "sink_port": "init_done", "width": 1 }
      ],
      "desc": "Init FSM signals init_done to calibration block."
    },
    {
      "id": "conn_16",
      "from": "init_fsm",
      "to": "refresh_ctrl",
      "category": "init",
      "signals": [
        { "source_port": "init_done", "sink_port": "init_done", "width": 1 }
      ],
      "desc": "Init FSM signals init_done to refresh controller."
    },
    {
      "id": "conn_17",
      "from": "init_fsm",
      "to": "config_regs",
      "category": "status",
      "signals": [
        { "source_port": "init_done", "sink_port": "sts_init_done",       "width": 1 },
        { "source_port": "init_fail", "sink_port": "sts_init_fail_event", "width": 1 }
      ],
      "desc": "Init FSM reports init_done and init_fail to CSR status."
    },
    {
      "id": "conn_18",
      "from": "calibration",
      "to": "config_regs",
      "category": "status",
      "signals": [
        { "source_port": "cal_done", "sink_port": "sts_cal_done", "width": 1 },
        { "source_port": "cal_fail", "sink_port": "sts_cal_fail", "width": 1 }
      ],
      "desc": "Calibration reports cal_done/cal_fail to CSR status."
    },
    {
      "id": "conn_19",
      "from": "refresh_ctrl",
      "to": "config_regs",
      "category": "status",
      "signals": [
        { "source_port": "ref_starve_flag", "sink_port": "sts_ref_starve_event", "width": 1 },
        { "source_port": "ref_pending_cnt", "sink_port": "sts_ref_pending_cnt",  "width": 3 }
      ],
      "desc": "Refresh controller reports starvation and pending count to CSR."
    }
  ],

