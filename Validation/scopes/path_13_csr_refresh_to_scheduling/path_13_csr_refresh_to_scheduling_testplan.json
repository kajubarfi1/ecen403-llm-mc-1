  },
  {
    "op": "drive",
    "signals": {
      "csr_cyc_i": 0,
      "csr_stb_i": 0
    },
    "comment": "Deassert bus"
  },
  {
    "op": "step",
    "cycles": 1,
    "comment": "Final idle cycle"
  }
