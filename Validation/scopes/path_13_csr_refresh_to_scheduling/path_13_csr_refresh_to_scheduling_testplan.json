      "csr_cyc_i": 0,
      "csr_stb_i": 0,
      "csr_we_i": 0
    },
    "comment": "Deassert"
  },
  {
    "op": "step",
    "cycles": 2000,
    "comment": "Allow system to stabilize and drain all pending refreshes"
  },
  {
    "op": "check",
    "expected": {
      "ref_starve_flag": 0,
      "ref_pending_cnt": 0
    },
    "comment": "After draining, starvation cleared and no pending refreshes"
  },
  {
    "op": "drive",
    "signals": {
      "init_done": 0,
      "sts_init_done": 0
    },
    "comment": "De-assert init_done to simulate re-initialization scenario"
  },
  {
    "op": "step",
    "cycles": 10,
    "comment": "Observe behavior when init not done"
  },
  {
    "op": "check",
    "expected": {
      "cmd_valid": 0
    },
    "comment": "Scheduler should not issue commands when init_done is deasserted"
  },
  {
    "op": "drive",
    "signals": {
      "init_done": 1,
      "sts_init_done": 1
    },
    "comment": "Re-assert init_done"
  },
  {
    "op": "step",
    "cycles": 5,
    "comment": "Resume normal operation"
  },
  {
    "op": "drive",
    "signals": {
      "csr_cyc_i": 1,
      "csr_stb_i": 1,
      "csr_we_i": 0,
      "csr_adr_i": 36,
      "csr_sel_i": 15,
      "csr_dat_i": 0
    },
    "comment": "Read back tREFI register to verify it survived init toggle"
  },
  {
    "op": "step",
    "cycles": 1,
    "comment": "CSR read"
  },
  {
    "op": "check",
    "expected": {
      "csr_ack_o": 1,
      "csr_dat_o": 6240
    },
